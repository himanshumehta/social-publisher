# social-publisher configuration.
# Copy to .env:  cp .env.example .env
# Every value below is a placeholder. The defaults run the full stack locally in
# DRY-RUN mode with zero credentials. docker-compose.yml overrides the
# DB_HOST / REDIS_ADDR / APP_HOST values so the same file works natively and in Docker.

# --- Publishing -------------------------------------------------------------
# true  = every platform adapter is a mock that logs "would publish ..." and marks
#         the post published. No platform API is called.
# false = real posting (needs connected channels + platform app review).
PUBLISH_DRY_RUN=true

# --- Dev bootstrap ----------------------------------------------------------
# When APP_ENV=development and both are set, the server creates/resets this admin
# at startup. Rejected outside development; there, create accounts with
#   go run ./cmd/admin create-user -email you@example.com -role admin
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=changeme-dev-only

# --- App --------------------------------------------------------------------
# "development" relaxes start-up checks. Any other value, or leaving it unset,
# is treated as production: strict validation (see internal/config).
APP_ENV=development
# HTTP port the API listens on
APP_PORT=8081
# bind address (compose sets 0.0.0.0)
APP_HOST=localhost
# allowed CORS origin for a separate frontend (a single origin, never *)
APP_FRONTEND_URL=http://localhost:5173
# Key rate limits by CF-Connecting-IP / X-Real-IP. Only behind a proxy that
# overwrites those headers.
TRUST_PROXY_HEADERS=false
# Let user-supplied URLs (source_url, image_url, thumbnails) reach private or
# loopback addresses. Keep false; true only to test against a local MinIO.
OUTBOUND_ALLOW_PRIVATE_NETWORKS=false
# host port docker compose publishes the API on
API_PORT=8081

# --- Database (PostgreSQL) --------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=socialpub
DB_PASSWORD=socialpub
DB_NAME=socialpub
# must not be "disable" in production
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# --- Redis (generation cache, rate limiting) --------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_TLS=false

# --- Auth -------------------------------------------------------------------
# >=32 random chars in production
JWT_SECRET=dev-jwt-secret-change-me-in-production
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h

# AES-256-GCM key (64 hex chars) for encrypting stored OAuth tokens.
# Required outside development. Empty = tokens stored unencrypted (development
# only). Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Retired keys still accepted for decryption during a rotation (comma-separated).
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# --- Object storage (S3-compatible; MinIO via `docker compose --profile storage`) ---
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=social-publisher-hot
S3_REGION=us-east-1
S3_USE_SSL=false

# --- Platform OAuth apps (only needed when PUBLISH_DRY_RUN=false) ------------
# Redirect URLs point at the backend: {APP_BASE_URL}/api/v1/admin/channels/oauth/{provider}/callback
# YouTube (Google Cloud Console, YouTube Data API v3)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8081/api/v1/admin/channels/oauth/google/callback
# Facebook Pages (Meta for Developers)
FACEBOOK_CLIENT_ID=your-meta-app-id
FACEBOOK_CLIENT_SECRET=your-meta-app-secret
FACEBOOK_REDIRECT_URL=http://localhost:8081/api/v1/admin/channels/oauth/facebook/callback
# Instagram Business Login (Meta for Developers)
INSTAGRAM_CLIENT_ID=your-instagram-app-id
INSTAGRAM_CLIENT_SECRET=your-instagram-app-secret
INSTAGRAM_REDIRECT_URL=http://localhost:8081/api/v1/admin/channels/oauth/instagram/callback
# Threads (separate Meta app with the Threads API product)
THREADS_CLIENT_ID=your-threads-app-id
THREADS_CLIENT_SECRET=your-threads-app-secret
THREADS_REDIRECT_URL=http://localhost:8081/api/v1/admin/channels/oauth/threads/callback
# X / Twitter (OAuth 2.0 user context)
TWITTER_CLIENT_ID=your-x-client-id
TWITTER_CLIENT_SECRET=your-x-client-secret
TWITTER_REDIRECT_URL=http://localhost:8081/api/v1/admin/channels/oauth/twitter/callback
# LinkedIn (Share on LinkedIn / organization posts)
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URL=http://localhost:8081/api/v1/admin/channels/oauth/linkedin/callback

# --- Optional: AI caption generation for posts created from a source_url -----
CLAUDE_API_KEY=
